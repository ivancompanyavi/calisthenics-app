# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example
docs/reference/*
# Personal/medical files pasted for the coach — they belong in the private
# data repo (the training-coach skill moves them), never in this public one.
docs/dexa*
docs/*.jpg
docs/*.png
docs/*.pdf

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent skills / tooling. `.claude/` stays local (installed/user-specific
# skills, local settings) EXCEPT repo-owned skills we deliberately version —
# git can't re-include a child of an excluded dir, hence the unignore chain.
.agents/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/training-coach/
skills-lock.json
